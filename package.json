{
  "name": "@inkbox/deepseek-harness-plugin",
  "version": "0.2.0",
  "description": "Give DeepSeek Harness agents persistent email, SMS, iMessage, voice, contacts, and agent-to-agent communication.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "inkbox-deepseek": "./dist/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkbox-ai/deepseek-harness-plugin.git"
  },
  "homepage": "https://inkbox.ai",
  "bugs": {
    "url": "https://github.com/inkbox-ai/deepseek-harness-plugin/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "inkbox",
    "email",
    "sms",
    "imessage",
    "voice",
    "agent"
  ],
  "dependencies": {
    "@inkbox/sdk": "0.6.4",
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "undici": "^7.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
